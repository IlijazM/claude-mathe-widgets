+if(!C||typeof C!=='object')throw new Error('CONFIG fehlt.');
+const TY={linear:'linear',linea:'linear',gerade:'linear',potenz:'potenz',power:'potenz',exponentiell:'exp',exponential:'exp',exp:'exp'}[String(C.type||'').toLowerCase().trim()];
